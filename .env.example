# Copy to .env and fill in. Do NOT commit your real .env (it is gitignored).

# OpenAI API key — required for Stage 1 (query optimization), Stage 4
# (embeddings) and Stage 5 (LLM verification).
OPENAI_API_KEY=

# PubMed / NCBI identification email (recommended; raises rate limits).
PUBMED_EMAIL=

# Optional: NCBI API key — raises E-utilities limit from 3 to 10 req/s.
# NCBI_API_KEY=

# Optional: custom OpenAI-compatible endpoint.
# OPENAI_BASE_URL=

# Optional model overrides.
# EMBEDDING=openai:text-embedding-3-small
# SMART_LLM=openai:gpt-4-turbo

# Reranker toggles (MCP server).
# CITATION_USE_RERANKER=1
# CITATION_SIM_THRESHOLD=0.5
